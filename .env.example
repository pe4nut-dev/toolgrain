# Public project connection details from Supabase Connect. Authentication uses a public key; billing secrets are listed below.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Server-only billing secrets. Never use NEXT_PUBLIC for these.
STRIPE_SECRET_KEY=YOUR_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=YOUR_STRIPE_WEBHOOK_SIGNING_SECRET
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
# Recurring prices must match the Stripe key mode (test/live).
STRIPE_PRO_MONTHLY_PRICE_ID=YOUR_MONTHLY_PRICE_ID
STRIPE_PRO_ANNUAL_PRICE_ID=YOUR_ANNUAL_PRICE_ID
# Server-only transactional SMTP. Keep the password in Vercel/local environment configuration.
SMTP_HOST=smtp.ionos.de
SMTP_PORT=465
SMTP_USER=info@toolgrain.com
SMTP_PASSWORD=YOUR_IONOS_MAILBOX_PASSWORD
SMTP_FROM_EMAIL=info@toolgrain.com
SMTP_FROM_NAME=Toolgrain
